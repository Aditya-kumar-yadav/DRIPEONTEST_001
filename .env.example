# =============================================================================
# DRIPEON — Environment Variables Template
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. NEVER commit .env — only this .env.example file
# =============================================================================


# =============================================================================
# 🗄️ DATABASE (Supabase PostgreSQL via Prisma)
# Get from: supabase.com → Project Settings → Database → Connection string
# Use Port 6543 (pooled) for DATABASE_URL, Port 5432 (direct) for DIRECT_URL
# =============================================================================
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connect_timeout=30"
DIRECT_URL="postgresql://user:password@host:5432/postgres?connect_timeout=30"


# =============================================================================
# 🔐 CLERK AUTH (Frontend + Backend)
# Get from: dashboard.clerk.com → API Keys
# IMPORTANT: Both VITE_ and non-VITE_ versions are required!
#   - VITE_ prefix → used by React frontend (baked in at build time)
#   - Without prefix → used by Express backend (runtime)
# =============================================================================
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...


# =============================================================================
# 🟢 SUPABASE (Frontend client)
# Get from: supabase.com → Project Settings → API
# =============================================================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here


# =============================================================================
# ☁️ CLOUDINARY (Image uploads)
# Get from: cloudinary.com → Dashboard
# =============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret


# =============================================================================
# 📧 EMAIL — SMTP (Nodemailer / Gmail App Password)
# Get from: Google Account → Security → App Passwords
# =============================================================================
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password


# =============================================================================
# 📨 RESEND (Transactional emails)
# Get from: resend.com → API Keys
# =============================================================================
RESEND_API_KEY=re_...


# =============================================================================
# 🤖 GEMINI AI
# Get from: aistudio.google.com → API Keys
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key


# =============================================================================
# 💳 RAZORPAY (Payments — India)
# Get from: dashboard.razorpay.com → Settings → API Keys
# =============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=


# =============================================================================
# 💳 STRIPE (Payments — International)
# Get from: dashboard.stripe.com → Developers → API Keys
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
VITE_STRIPE_PUBLISHABLE_KEY=


# =============================================================================
# 🔥 FIREBASE (Phone OTP Auth)
# Get from: console.firebase.google.com → Project Settings → General
# =============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=


# =============================================================================
# ⚙️ APP CONFIG
# =============================================================================
NODE_ENV=production
PORT=10000
