    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.0",
    "browser-image-compression": "^2.0.2",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
