{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "cross-env DATABASE_URL=\"postgresql://dummy:dummy@localhost:5432/dummy\" prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:render": "DATABASE_URL=\"postgresql://dummy:dummy@localhost:5432/dummy\" prisma generate && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.8",
    "@clerk/express": "^2.1.75",
    "@clerk/themes": "^2.4.57",
    "@google/genai": "^2.4.0",
    "@imgly/background-removal": "^1.7.0",
    "@marsidev/react-turnstile": "^1.6.0",
    "@n8n/chat": "^1.25.0",
    "@prisma/client": "^5.22.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.98",
    "@stripe/react-stripe-js": "^6.6.0",
    "@stripe/stripe-js": "^9.8.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/nodemailer": "^8.0.2",
    "@types/three": "^0.185.4",
    "@upstash/redis": "^1.38.2",
